# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# COMPOSIO_API_KEY: Server-side API key for Composio SDK (@composio/core) to manage WhatsApp Business connections and messages.
# Configure via AI Studio Secrets / server environment (never exposed to browser UI).
COMPOSIO_API_KEY="MY_COMPOSIO_API_KEY"

# COMPOSIO_WHATSAPP_AUTH_CONFIG_ID: Auth Config ID from Composio Dashboard for the WhatsApp Business toolkit (optional if auto-discovered).
COMPOSIO_WHATSAPP_AUTH_CONFIG_ID=""

# COMPOSIO_WEBHOOK_SECRET: segredo de assinatura dos webhooks do Composio (obrigatório; sem ele o webhook responde 403).
COMPOSIO_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# OUTLOOK / EMAIL BRIDGE (Nota de Debito PDF Dispatch)
# Configure ONE of the options below in AI Studio Secrets (never expose in UI):
#
# Option A (Recommended when Microsoft 365 disables SMTP AUTH): Microsoft 365 OAuth 2.0 (Delegated Graph)
# Requires ONLY OUTLOOK_CLIENT_ID (and optional OUTLOOK_CLIENT_SECRET / OUTLOOK_TENANT_ID="common").
# Then click "Conectar minha conta Outlook" inside the app!
# ------------------------------------------------------------------------------
OUTLOOK_TENANT_ID=""
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_SENDER_EMAIL=""

# ------------------------------------------------------------------------------
# Option B (Fastest zero-Azure-admin HTTPS API — bypasses Microsoft SMTP AUTH block):
# Use EITHER Brevo (300/day free, any verified sender email) OR Resend (3000/mo free)
# ------------------------------------------------------------------------------
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ------------------------------------------------------------------------------
# Option C (Zero-Azure-admin Outlook Native via Power Automate / Make / n8n Webhook):
# Receives JSON { to, cc, subject, bodyText, fileName, pdfBase64 }
# ------------------------------------------------------------------------------
OUTLOOK_WEBHOOK_URL=""
OUTLOOK_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Option D (SMTP — works with Gmail App Password or Microsoft 365 if SMTP AUTH enabled):
# ------------------------------------------------------------------------------
OUTLOOK_SMTP_HOST="smtp.office365.com"
OUTLOOK_SMTP_PORT="587"
OUTLOOK_SMTP_USER=""
OUTLOOK_SMTP_PASS=""

# ------------------------------------------------------------------------------
# Option E (Zero Azure setup via Composio OAuth): Composio Outlook Account ID
# ------------------------------------------------------------------------------
COMPOSIO_OUTLOOK_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# SEGURANÇA / AUTENTICAÇÃO (Firebase Admin e webhooks)
# ------------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT: JSON da conta de serviço do Firebase Admin (dispensável no Cloud Run, que usa ADC).
FIREBASE_SERVICE_ACCOUNT=""
# MASTER_EMAILS: e-mails (separados por vírgula) que recebem acesso master.
MASTER_EMAILS=""
# WEBHOOK_SECRET: segredo exigido no webhook de comprovantes (?token= ou header x-webhook-token).
WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# WHATSAPP (antes fixos no código)
# ------------------------------------------------------------------------------
# WHATSAPP_VERIFY_TOKEN: token do handshake GET (hub.verify_token) do webhook de comprovantes.
WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_API_KEY: chave padrão da instância Evolution API / Z-API.
WHATSAPP_API_KEY=""
# OWNER_PHONE: telefone do responsável usado como destino padrão quando nenhum número está conectado.
OWNER_PHONE=""
# AUTHORIZED_PHONES: telefones autorizados a enviar comprovantes (separados por vírgula).
AUTHORIZED_PHONES=""
# DEFAULT_ORG_ID: ID real da empresa no Firestore que herda os registros antigos do servidor (org_aguero_default).
DEFAULT_ORG_ID=""

# ------------------------------------------------------------------------------
# NF-e: BUSCA AUTOMÁTICA NA SEFAZ (Distribuição DF-e + Ciência da Operação)
# ------------------------------------------------------------------------------
# Sem estas variáveis a busca automática fica desligada (o upload manual de XML continua funcionando).
# NFE_CERT_PFX_BASE64: certificado A1 (.pfx) da empresa convertido em base64. É a assinatura legal da empresa: só nos Secrets.
NFE_CERT_PFX_BASE64=""
# NFE_CERT_PASSWORD: senha do certificado A1.
NFE_CERT_PASSWORD=""
# NFE_CNPJ: CNPJ da empresa dona do certificado (com ou sem pontuação).
NFE_CNPJ=""
# NFE_UF: código IBGE da UF da empresa (ex.: 35 = SP, 33 = RJ, 31 = MG, 41 = PR).
NFE_UF=""
# NFE_AMBIENTE: 2 = homologação (testes, padrão), 1 = produção.
NFE_AMBIENTE="2"
# NFE_ORG_ID: ID da empresa no Firestore (coleção organizations) que recebe as notas desse CNPJ.
NFE_ORG_ID=""
# NFE_CA_PEM (opcional): cadeia ICP-Brasil em PEM, só se o log mostrar "unable to get local issuer certificate".
NFE_CA_PEM=""

# TOTVS Protheus (diagnóstico da API REST; usado pelo futuro módulo Protheus)
# PROTHEUS_URL: endereço do Protheus, ex: https://<empresa>.protheus.cloudtotvs.com.br:10203
# PROTHEUS_USER / PROTHEUS_PASSWORD: usuário do Protheus que o AgueroFlow usa para consultar (Secrets, nunca no código)
PROTHEUS_URL=""
PROTHEUS_USER=""
PROTHEUS_PASSWORD=""

# ND_EXPORT_TOKEN: chave do script que salva as NDs na pasta de rede do financeiro (docs/nd-pasta-rede.md)
ND_EXPORT_TOKEN=""

# MARTRAVEL_SECRET_KEY: chave do cofre onde fica o login da Mar Travel de cada colaborador (base64 de 32 bytes).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MARTRAVEL_SECRET_KEY=""

# Lemontech WsSelfBooking (API oficial da Mar Travel). Valores vêm da implantação Lemontech.
LEMONTECH_WS_USER=
LEMONTECH_WS_PASSWORD=
LEMONTECH_WS_KEYCLIENT=
# producao (padrão) ou treinamento
LEMONTECH_WS_ENV=producao
# Opcional: id da empresa (orgId) no AgueroFlow que pode usar esta conta. Vazio = qualquer empresa do sistema.
LEMONTECH_WS_ORG_ID=
