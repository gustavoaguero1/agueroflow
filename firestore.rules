rules_version = '2';
// Org isolation. Claims are set by the server: { master: bool, orgs: { [orgId]: Role } }.
// Collection inventory and owner fields: docs/firestore-collections.md. Anything not matched here is denied.
// The Admin SDK (server) bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMaster() { return signedIn() && request.auth.token.get('master', false) == true; }
    function orgClaims() { return request.auth.token.get('orgs', {}); }
    function isMemberOf(org) { return signedIn() && org is string && org != '' && org in orgClaims(); }
    function hasRole(org, roles) { return isMemberOf(org) && orgClaims()[org] in roles; }
    function hasAnyOrg() { return signedIn() && orgClaims().size() > 0; }
    // Owner field is orgId, else organizationId.
    function orgOf(d) { return d.get('orgId', d.get('organizationId', '')); }

    // Reads need the same owner check as writes (a mixed-owner doc is readable only by members of both orgs).
    // A missing doc reveals nothing, so getDoc on it stays allowed (callers check exists()).
    function canRead(res) { return isMaster() || (res == null && signedIn()) || ownerOk(res.data); }
    // Writes: at least one owner field, and every owner field present must be one of the caller's orgs.
    function ownerOk(d) {
      let o = d.get('orgId', null);
      let p = d.get('organizationId', null);
      return (o in [null, ''] || isMemberOf(o)) && (p in [null, ''] || isMemberOf(p)) && (isMemberOf(o) || isMemberOf(p));
    }
    function sameOwner() {
      return request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
        && request.resource.data.get('organizationId', null) == resource.data.get('organizationId', null);
    }
    function canCreate() { return isMaster() || ownerOk(request.resource.data); }
    function canUpdate() { return sameOwner() && (isMaster() || ownerOk(resource.data)); }
    function canDelete() { return isMaster() || ownerOk(resource.data); }

    // ---- Server-only (Admin SDK) -------------------------------------------
    match /member_credentials/{id} { allow read, write: if false; }
    match /first_access_tokens/{id} { allow read, write: if false; }
    match /system_security/{id} { allow read, write: if false; } // legacy master-password doc
    match /users/{id} { allow read, write: if false; } // unused by the client
    match /receipt_images/{id} { allow read, write: if false; } // served by GET /api/reembolsos/:id/imagem
    match /server_state/{id} { allow read, write: if false; } // server markers (e.g. weekly reimbursement summary)

    // Connectivity probe in src/firebase.ts (testConnection).
    match /test/{docId} { allow get: if signedIn() && docId == 'connection'; }

    // OS number sequence: members create it once (seq >= 1) and may only bump it by 1; never reset or delete.
    match /counters/{docId} {
      allow read: if canRead(resource);
      allow create: if (isMaster() || ownerOk(request.resource.data)) && request.resource.data.get('seq', 0) >= 1
        && (isMaster() || docId == request.resource.data.get('orgId', '') + '_work_orders'); // deterministic id: no squatting another org's counter
      allow update: if sameOwner() && (isMaster() || ownerOk(resource.data))
        && request.resource.data.seq == resource.data.seq + 1;
    }

    // ---- Organizations ------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create, delete: if isMaster();
      allow update: if isMaster() || hasRole(orgId, ['Admin']);
    }

    // ---- Members --------------------------------------------------------------
    match /org_members/{memberId} {
      function isSelf() {
        return resource.data.get('userId', '') == request.auth.uid || request.auth.uid == 'member_' + memberId;
      }
      // A Gerente may not create, change or remove an Admin.
      function roleOk(org, d) { return isMaster() || orgClaims()[org] == 'Admin' || d.get('role', '') != 'Admin'; }
      function manages(org) { return isMaster() || hasRole(org, ['Admin', 'Gerente']); }

      allow read: if isMaster() || (resource == null && signedIn())
        || isMemberOf(resource.data.get('orgId', ''))
        || (signedIn() && (resource.data.get('userId', '') == request.auth.uid || request.auth.uid == 'member_' + memberId))
        || (signedIn() && request.auth.token.get('email_verified', false) == true
            && request.auth.token.get('email', null) is string
            && resource.data.get('userEmail', '') == request.auth.token.email.lower());
      allow create: if !('passwordHash' in request.resource.data)
        && request.resource.data.get('userId', '') in ['', request.auth.uid]
        && manages(request.resource.data.get('orgId', ''))
        && roleOk(request.resource.data.get('orgId', ''), request.resource.data);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordHash', 'userId'])
        && (isMaster()
          || (manages(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId
              && roleOk(resource.data.orgId, resource.data) && roleOk(resource.data.orgId, request.resource.data))
          || (signedIn() && isSelf()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName', 'updatedAt', 'lastLoginAt'])));
      allow delete: if manages(resource.data.orgId) && roleOk(resource.data.orgId, resource.data);
    }

    // ---- Trusted devices (orgId + userId) ------------------------------------
    match /trusted_devices/{deviceId} {
      allow read: if canRead(resource);
      allow create: if canCreate() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update, delete: if (isMaster()
          || (ownerOk(resource.data)
              && (resource.data.get('userId', '') == request.auth.uid || hasRole(orgOf(resource.data), ['Admin', 'Gerente']))))
        && (request.method == 'delete' || (sameOwner() && request.resource.data.get('userId', '') == resource.data.get('userId', '')));
    }

    // ---- Operações (public/operacoes, ponte em src/modules/operations/opsBridge.ts) ----
    // Cada empresa tem a própria base em ops_orgs/{orgId}/<coleção>/<doc>.
    // Salários: só Admin/Gerente. Equipe (membros) e parâmetros (config): escrita só Admin/Gerente.
    // Visualizador só lê. Demais perfis da empresa leem e escrevem.
    match /ops_orgs/{orgId}/{coll}/{docId} {
      function opsManager() { return isMaster() || hasRole(orgId, ['Admin', 'Gerente']); }
      function opsWriter() { return isMaster() || hasRole(orgId, ['Admin', 'Gerente', 'Supervisor', 'Operacional']); }
      function managerOnlyWrite() { return coll in ['membros'] || (coll == 'config' && docId == 'params'); }
      allow read: if coll == 'salarios' ? opsManager() : (isMaster() || isMemberOf(orgId));
      allow write: if coll == 'salarios' || managerOnlyWrite() ? opsManager() : opsWriter();
    }

    // ---- Org-scoped by orgId / organizationId field ----------------------------
    match /{coll}/{docId} {
      function orgScoped() {
        return coll in [
          // orgId
          'assets', 'checklist_runs', 'checklist_templates', 'collective_asset_categories',
          'collective_asset_movements', 'collective_asset_services', 'collective_asset_workers',
          'collective_assets', 'construction_milestones', 'construction_reports', 'constructions',
          'contracts', 'cost_centers', 'field_workers', 'inspections', 'item_categories', 'items',
          'lpu_approvals', 'occurrences', 'order_messages', 'recurring_orders', 'rh_batches',
          'rh_calculations', 'rh_employees', 'rh_imports', 'stock_balances', 'support_tickets',
          'teams', 'units', 'work_order_statuses', 'work_orders', 'work_shifts', 'worker_time_logs',
          // organizationId
          'commercial_clients', 'commercial_cost_compositions', 'commercial_imports',
          'commercial_materials', 'commercial_proposals', 'hr_onboardings', 'purchasing_orders',
          'purchasing_quotations', 'purchasing_receipts', 'purchasing_requisitions',
          'purchasing_suppliers', 'travel_requests', 'travel_searches'
        ];
      }
      // Append-only history.
      function immutable() { return coll in ['order_events', 'stock_movements', 'audit_logs']; }
      // Doc id is the orgId.
      function perOrgDoc() { return coll in ['overtime_rules', 'collective_asset_policies', 'commercial_policies']; }

      allow read: if (orgScoped() || immutable()) && canRead(resource);
      // Deterministic ids (finance_*, NF-e items) must embed the owner org, so one tenant cannot pre-claim another's ids.
      function idHasOrg(prefix, d) { let p = prefix + orgOf(d) + '_'; return docId.size() > p.size() && docId[0:p.size()] == p; }
      function nfeItemOk() { return coll != 'items' || docId[0:9] != 'item_nfe_' || idHasOrg('item_nfe_', request.resource.data); }
      allow create: if (orgScoped() || immutable()) && canCreate() && nfeItemOk();
      allow update: if orgScoped() && canUpdate();
      allow delete: if orgScoped() && canDelete();

      // Finance: members read; Admin/Gerente/Supervisor create/update; Admin/Gerente delete.
      function finance() { return coll in ['finance_payables', 'finance_categories', 'finance_rules']; }
      function financeRole(d, roles) { return isMaster() || hasRole(orgOf(d), roles); }
      function isPayable() { return coll == 'finance_payables'; }
      // Payables: Supervisor may only settle an open one (aberto → pago); Admin/Gerente edit freely.
      function supervisorPays() {
        return hasRole(orgOf(resource.data), ['Supervisor'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pagoEm', 'pagoPor', 'updatedAt'])
          && resource.data.get('status', '') == 'aberto' && request.resource.data.get('status', '') == 'pago'
          && request.resource.data.get('pagoPor', '') == request.auth.uid;
      }
      allow read: if finance() && canRead(resource);
      allow create: if finance() && canCreate() && (isMaster() || idHasOrg({'finance_categories': 'cat_', 'finance_payables': 'pay_', 'finance_rules': 'rule_'}[coll], request.resource.data)) && financeRole(request.resource.data, ['Admin', 'Gerente', 'Supervisor'])
        && (!isPayable() || request.resource.data.get('createdBy', '') == request.auth.uid);
      allow update: if finance() && canUpdate()
        && (isPayable() ? (financeRole(resource.data, ['Admin', 'Gerente']) || supervisorPays())
                        : financeRole(resource.data, ['Admin', 'Gerente', 'Supervisor']));
      allow delete: if finance() && canDelete() && financeRole(resource.data, ['Admin', 'Gerente']);

      allow read: if perOrgDoc() && (isMaster() || isMemberOf(docId));
      allow write: if perOrgDoc() && (isMaster() || isMemberOf(docId))
        && (request.method == 'delete'
            || (request.resource.data.get('orgId', docId) == docId && request.resource.data.get('organizationId', docId) == docId));
    }

    // ---- NF-e (written by the server; the client only moves classification status) ----
    match /nfe_documents/{id} {
      function move() { return resource.data.get('status', '') + '>' + request.resource.data.get('status', ''); }
      function run() { return resource.data.get('classificacao', {}); }
      function ownRun() { return run().get('by', '') == request.auth.uid; }
      // A run left 'classificando' for 2+ minutes (server time) — or a legacy one without startedAt — may be released by Admin/Gerente.
      function stale() { return !(run().get('startedAt', null) is timestamp) || request.time > run().startedAt + duration.value(2, 'm'); }
      function newRun() {
        let r = request.resource.data.get('classificacao', {});
        return r.get('by', '') == request.auth.uid && r.get('startedAt', null) == request.time;
      }
      function manager() { return isMaster() || hasRole(orgOf(resource.data), ['Admin', 'Gerente']); }
      allow read: if canRead(resource);
      allow update: if canUpdate()
        && (manager() || hasRole(orgOf(resource.data), ['Supervisor']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'classificacao', 'erroClassificacao', 'updatedAt'])
        && ((move() in ['aguardando_classificacao>classificando', 'erro_classificacao>classificando']
             && newRun())
          || (move() == 'classificando>classificada' && ownRun())
          || (move() == 'classificando>erro_classificacao' && (ownRun() || (manager() && stale()))));
    }
    match /nfe_sync/{orgId} { allow read: if isMaster() || isMemberOf(orgId); }

    // Items carry organizationId, but the client lists them by proposalId only: fall back to the parent proposal's org.
    match /commercial_proposal_items/{itemId} {
      function parentOrg(d) {
        return get(/databases/$(database)/documents/commercial_proposals/$(d.proposalId)).data.get('organizationId', '');
      }
      // A new/updated item must belong to its parent proposal's org (no attaching items to another org's proposal).
      function matchesParent() {
        return exists(/databases/$(database)/documents/commercial_proposals/$(request.resource.data.proposalId))
          && parentOrg(request.resource.data) == request.resource.data.get('organizationId', '');
      }
      allow read: if canRead(resource) || isMemberOf(parentOrg(resource.data));
      allow create: if canCreate() && matchesParent();
      allow update: if canUpdate() && matchesParent();
      allow delete: if canDelete() || isMemberOf(parentOrg(resource.data));
    }

    // ---- WhatsApp bridge mirror ----------------------------------------------
    // The bridge is one server-wide instance: its data has no org owner and the server API serves it to any
    // authenticated member. The mirror matches that: any member of some org (or master).
    function waMember() { return isMaster() || hasAnyOrg(); }

    match /whatsapp_contacts/{id} { allow read, write: if waMember(); }
    match /whatsapp_quick_replies/{id} { allow read, write: if waMember(); }
    match /whatsapp_ai_rules/{id} { allow read, write: if waMember(); }
    match /whatsapp_ai_settings/{id} { allow read, write: if waMember(); }

    match /whatsapp_scheduled_jobs/{jobId} {
      allow read, delete: if waMember();
      allow create, update: if waMember()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.scheduleTime is string
        && request.resource.data.scheduleTime.matches('^\\d{2}:\\d{2}$')
        && request.resource.data.promptInstruction is string
        && request.resource.data.promptInstruction.size() > 0
        && request.resource.data.promptInstruction.size() <= 2000;
    }

    match /whatsapp_ocr_receipts/{receiptId} {
      allow read: if waMember();
      allow create, update: if waMember()
        && request.resource.data.establishmentName is string
        && request.resource.data.establishmentName.size() <= 200
        && request.resource.data.totalAmount is number;
    }

    match /whatsapp_nd_rules/{ruleId} {
      allow read, delete: if waMember();
      allow create, update: if waMember()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.groupJid is string;
    }

    match /whatsapp_nd_records/{recordId} {
      allow read: if waMember();
      allow create, update: if waMember()
        && request.resource.data.receiverName is string
        && request.resource.data.receiverName.size() <= 180
        && request.resource.data.amount is number;
    }
  }
}
