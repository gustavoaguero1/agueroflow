rules_version = '2';
// Org isolation. Claims are set by the server: { master: bool, orgs: { [orgId]: Role } }.
// Collection inventory and owner fields: docs/firestore-collections.md. Anything not matched here is denied.
// The Admin SDK (server) bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMaster() { return signedIn() && request.auth.token.get('master', false) == true; }
    function orgClaims() { return request.auth.token.get('orgs', {}); }
    function isMemberOf(org) { return signedIn() && org is string && org != '' && org in orgClaims(); }
    function hasRole(org, roles) { return isMemberOf(org) && orgClaims()[org] in roles; }
    function hasAnyOrg() { return signedIn() && orgClaims().size() > 0; }
    // Owner field is orgId, else organizationId.
    function orgOf(d) { return d.get('orgId', d.get('organizationId', '')); }

    // Reads need the same owner check as writes (a mixed-owner doc is readable only by members of both orgs).
    // A missing doc reveals nothing, so getDoc on it stays allowed (callers check exists()).
    function canRead(res) { return isMaster() || (res == null && signedIn()) || ownerOk(res.data); }
    // Writes: at least one owner field, and every owner field present must be one of the caller's orgs.
    function ownerOk(d) {
      let o = d.get('orgId', null);
      let p = d.get('organizationId', null);
      return (o in [null, ''] || isMemberOf(o)) && (p in [null, ''] || isMemberOf(p)) && (isMemberOf(o) || isMemberOf(p));
    }
    function sameOwner() {
      return request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
        && request.resource.data.get('organizationId', null) == resource.data.get('organizationId', null);
    }
    function canCreate() { return isMaster() || ownerOk(request.resource.data); }
    function canUpdate() { return sameOwner() && (isMaster() || ownerOk(resource.data)); }
    function canDelete() { return isMaster() || ownerOk(resource.data); }

    // ---- Acesso por área (src/permissions/areas.ts) ------------------------------
    // Token: areas[org] = um dígito por área (0 sem acesso, 1 ver, 2 editar), na ordem abaixo.
    // Sem `areas` para a empresa: padrão do perfil (mesma tabela de ROLE_DEFAULTS; tests/areaRulesSync.test.ts confere).
    // Ordem: painel 0, operacoes 1, estoque 2, comercial 3, financeiro 4, rh 5, whatsapp 6, relatorios 7, estrutura 8, configuracoes 9, suporte 10
    function roleAreas(role) {
      return {
        'Admin': '22222222222',
        'Gerente': '22222122212',
        'Supervisor': '12212021112',
        'Operacional': '12100010112',
        'Visualizador': '11110011112'
      }.get(role, '10000000011'); // perfil desconhecido: só os mínimos
    }
    function areaCode(org) { return request.auth.token.get('areas', {}).get(org, roleAreas(orgClaims()[org])); }
    function areaLevel(org, i) { return isMaster() ? 2 : (isMemberOf(org) ? int(areaCode(org)[i:i + 1]) : 0); }
    function areaOk(org, i, lvl) { return isMaster() || areaLevel(org, i) >= lvl; }
    function A_OPS() { return 1; }
    function A_STOCK() { return 2; }
    function A_COM() { return 3; }
    function A_FIN() { return 4; }
    function A_RH() { return 5; }


    // ---- Segurança do Trabalho & SMS: dedicated collection rules -----------------
      function safetyRiskRank(level) {
        return level == 'baixo' ? 1 : level == 'medio' ? 2 : level == 'alto' ? 3 : level == 'critico' ? 4 : 0;
      }
      function validSafetyRiskItem(risk) {
        return risk is map
          && risk.get('hazard', '') is string && risk.get('hazard', '').size() >= 3 && risk.get('hazard', '').size() <= 180
          && risk.get('consequence', '') is string && risk.get('consequence', '').size() >= 3 && risk.get('consequence', '').size() <= 300
          && risk.get('initialRisk', '') in ['baixo', 'medio', 'alto', 'critico']
          && risk.get('controlMeasures', '') is string && risk.get('controlMeasures', '').size() >= 5 && risk.get('controlMeasures', '').size() <= 700
          && risk.get('residualRisk', '') in ['baixo', 'medio', 'alto', 'critico']
          && safetyRiskRank(risk.get('residualRisk', '')) <= safetyRiskRank(risk.get('initialRisk', ''));
      }
      function validSafetyRiskList(d) {
        let risks = d.get('risks', []);
        return d.get('risks', null) is list
          && risks.size() >= 1 && risks.size() <= 5
          && validSafetyRiskItem(risks[0])
          && (risks.size() < 2 || validSafetyRiskItem(risks[1]))
          && (risks.size() < 3 || validSafetyRiskItem(risks[2]))
          && (risks.size() < 4 || validSafetyRiskItem(risks[3]))
          && (risks.size() < 5 || validSafetyRiskItem(risks[4]));
      }
      function validSafetyAprLink(d) {
        let documentType = d.get('documentType', '');
        let aprId = d.get('relatedAprId', '');
        let safeAprId = aprId is string && aprId.size() > 0 ? aprId : '__missing_apr__';
        let aprPath = /databases/$(database)/documents/safety_permits/$(safeAprId);
        let aprStatePath = /databases/$(database)/documents/safety_permit_states/$(safeAprId);
        let aprExists = exists(aprPath);
        let stateExists = exists(aprStatePath);
        let apr = aprExists ? get(aprPath).data : {};
        let aprState = stateExists ? get(aprStatePath).data : {};
        return documentType == 'apr'
          ? !d.keys().hasAny(['relatedAprId'])
          : (documentType == 'pt'
            && aprId is string && aprId.size() > 0
            && aprExists && stateExists
            && apr.get('documentType', '') == 'apr'
            && orgOf(apr) == orgOf(d)
            && apr.get('unitId', '') == d.get('unitId', '')
            && apr.get('contractId', '') == d.get('contractId', '')
            && aprState.get('permitId', '') == aprId
            && aprState.get('status', '') == 'approved');
      }
      function validSafetyPermitCreate(permitId) {
        let d = request.resource.data;
        let permitType = d.get('permitType', '');
        let documentType = d.get('documentType', '');
        let controls = d.get('controls', {});
        return 
          signedIn()
          && d.get('id', '') == permitId
          && d.get('orgId', '') is string && d.get('orgId', '').size() > 0
          && documentType in ['apr', 'pt']
          && d.get('permitCode', '') is string
          && (documentType == 'apr'
            ? d.get('permitCode', '').matches('^APR-[0-9]{4}-[A-Z0-9]{8}$')
            : d.get('permitCode', '').matches('^PT-[0-9]{4}-[A-Z0-9]{8}$'))
          && d.get('permitDate', '') is string
          && d.get('permitDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && permitType in ['trabalho_a_quente', 'trabalho_em_altura', 'espaco_confinado', 'eletrico', 'icamento', 'abertura_de_linha', 'geral']
          && d.get('unitId', '') is string && d.get('unitId', '').size() > 0
          && d.get('contractId', '') is string && d.get('contractId', '').size() > 0
          && d.get('activityTitle', '') is string && d.get('activityTitle', '').size() >= 3 && d.get('activityTitle', '').size() <= 160
          && d.get('description', '') is string && d.get('description', '').size() >= 10 && d.get('description', '').size() <= 2000
          && d.get('location', '') is string && d.get('location', '').size() >= 2 && d.get('location', '').size() <= 180
          && d.get('validFrom', '') is string && d.get('validFrom', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
          && d.get('validUntil', '') is string && d.get('validUntil', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
          && d.get('validUntil', '') > d.get('validFrom', '')
          && d.get('supervisorName', '') is string && d.get('supervisorName', '').size() >= 2 && d.get('supervisorName', '').size() <= 120
          && d.get('teamMembers', null) is list && d.get('teamMembers', []).size() >= 1 && d.get('teamMembers', []).size() <= 30
          && d.get('teamMembers', [])[0] is string
          && (documentType != 'pt' || (d.get('teamMemberIds', null) is list
            && d.get('teamMemberIds', []).size() >= 1 && d.get('teamMemberIds', []).size() <= 30
            && d.get('teamMemberIds', [])[0] is string && d.get('teamMemberIds', [])[0].size() > 0))
          && validSafetyRiskList(d)
          && controls is map
          && controls.get('teamBriefed', false) == true
          && controls.get('ppeInspected', false) == true
          && controls.get('areaIsolated', false) == true
          && (permitType != 'trabalho_a_quente' || controls.get('fireWatch', false) == true)
          && (permitType != 'trabalho_em_altura' || (controls.get('fallProtection', false) == true && controls.get('anchorVerified', false) == true))
          && (permitType != 'espaco_confinado' || (controls.get('gasTest', false) == true && controls.get('rescuePlan', false) == true && controls.get('standbyWatch', false) == true))
          && (permitType != 'eletrico' || (controls.get('lockoutTagout', false) == true && controls.get('zeroEnergyVerified', false) == true))
          && (permitType != 'abertura_de_linha' || (controls.get('lockoutTagout', false) == true && controls.get('zeroEnergyVerified', false) == true))
          && (permitType != 'icamento' || controls.get('liftPlanReviewed', false) == true)
          && d.get('emergencyPlan', '') is string && d.get('emergencyPlan', '').size() >= 10 && d.get('emergencyPlan', '').size() <= 1500
          && d.get('createdByUid', '') == request.auth.uid
          && d.get('createdByName', '') is string && d.get('createdByName', '').size() > 0
          && d.get('createdAt', null) == request.time
          && validSafetyAprLink(d);
      }
      function validSafetyPermitEventCreateForDoc() {
        let permitId = request.resource.data.get('permitId', '');
        let safePermitId = permitId is string && permitId.size() > 0 ? permitId : '__missing_permit__';
        let permitPath = /databases/$(database)/documents/safety_permits/$(safePermitId);
        let permitExists = exists(permitPath);
        let permit = permitExists ? get(permitPath).data : {};
        let eventType = request.resource.data.get('eventType', '');
        let hasPrevious = request.resource.data.keys().hasAny(['previousEventId']);
        return signedIn()
          && permitExists
          && request.resource.data.get('orgId', '') == orgOf(permit)
          && request.resource.data.get('unitId', '') == permit.get('unitId', '')
          && request.resource.data.get('contractId', '') == permit.get('contractId', '')
          && !exists(/databases/$(database)/documents/safety_permit_states/$(safePermitId))
          && eventType == 'created'
          && request.resource.data.get('actorUid', '') == request.auth.uid
          && request.resource.data.get('actorName', '') is string
          && request.resource.data.get('actorName', '').size() > 0
          && request.resource.data.get('recordedAt', null) == request.time
          && (eventType == 'created' ? !hasPrevious
            : (hasPrevious && request.resource.data.get('previousEventId', '') is string
              && request.resource.data.get('previousEventId', '').size() > 0))
          && (eventType in ['rejected', 'closed', 'cancelled']
            ? (request.resource.data.get('comment', '') is string
              && request.resource.data.get('comment', '').size() >= 5
              && request.resource.data.get('comment', '').size() <= 1500)
            : true);
      }
      function validSafetyPermitEventCreate() {
        return validSafetyPermitEventCreateForDoc();
      }
      function validSafetyPermitStateCreateForDoc(permitId) {
        let permitPath = /databases/$(database)/documents/safety_permits/$(permitId);
        let eventId = request.resource.data.get('latestEventId', '');
        let safeEventId = eventId is string && eventId.size() > 0 ? eventId : '__missing_event__';
        let eventPath = /databases/$(database)/documents/safety_permit_events/$(safeEventId);
        let permitExists = exists(permitPath);
        let permit = permitExists ? get(permitPath).data : {};
        let eventExists = exists(eventPath);
        let event = eventExists ? get(eventPath).data : {};
        return signedIn()
          && permitExists && eventExists
          && request.resource.data.get('id', '') == permitId
          && request.resource.data.get('permitId', '') == permitId
          && request.resource.data.get('orgId', '') == orgOf(permit)
          && request.resource.data.get('unitId', '') == permit.get('unitId', '')
          && request.resource.data.get('contractId', '') == permit.get('contractId', '')
          && request.resource.data.get('status', '') == 'draft'
          && event.get('permitId', '') == permitId
          && event.get('eventType', '') == 'created'
          && event.get('actorUid', '') == request.auth.uid
          && request.resource.data.get('updatedByUid', '') == request.auth.uid
          && request.resource.data.get('updatedByName', '') is string
          && request.resource.data.get('updatedByName', '').size() > 0
          && request.resource.data.get('updatedAt', null) == request.time;
      }
      function validSafetyPermitStateCreate(permitId) {
        return validSafetyPermitStateCreateForDoc(permitId);
      }
      function safetyStatusAfter(currentStatus, eventType) {
        return eventType == 'submitted_for_approval' && currentStatus in ['draft', 'rejected'] ? 'awaiting_approval'
          : eventType == 'approved' && currentStatus == 'awaiting_approval' ? 'approved'
          : eventType == 'rejected' && currentStatus == 'awaiting_approval' ? 'rejected'
          : eventType == 'closed' && currentStatus == 'approved' ? 'closed'
          : eventType == 'cancelled' && currentStatus in ['draft', 'awaiting_approval', 'rejected', 'approved'] ? 'cancelled'
          : eventType == 'note_added' && currentStatus != '' ? currentStatus : '';
      }
      function validSafetyOccurrencePermit(d) {
        let permitId = d.get('relatedPermitId', '');
        let safePermitId = permitId is string && permitId.size() > 0 ? permitId : '__missing_permit__';
        let permitPath = /databases/$(database)/documents/safety_permits/$(safePermitId);
        let permitExists = exists(permitPath);
        let permit = permitExists ? get(permitPath).data : {};
        return permitId == '' || (permitExists && orgOf(permit) == orgOf(d)
          && permit.get('unitId', '') == d.get('unitId', ''));
      }
      function validSafetyOccurrenceUpdate() {
        return !resource.data.keys().hasAny(['safetyCategory']) || (
          request.resource.data.get('id', '') == resource.data.get('id', '')
          && request.resource.data.get('orgId', '') == resource.data.get('orgId', '')
          && request.resource.data.get('unitId', '') == resource.data.get('unitId', '')
          && request.resource.data.get('type', '') == 'seguranca'
          && request.resource.data.get('safetyCategory', '') == resource.data.get('safetyCategory', '')
          && request.resource.data.get('incidentDate', '') == resource.data.get('incidentDate', '')
          && request.resource.data.get('relatedPermitId', '') == resource.data.get('relatedPermitId', '')
          && request.resource.data.get('reportedByUid', '') == resource.data.get('reportedByUid', '')
          && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        );
      }
      function validSafetyOccurrenceCreate(occurrenceId) {
        return 
          signedIn()
          && request.resource.data.get('id', '') == occurrenceId
          && request.resource.data.get('type', '') == 'seguranca'
          && request.resource.data.get('safetyCategory', '') in ['quase_acidente', 'condicao_insegura', 'ato_inseguro', 'incidente_sem_lesao', 'acidente_com_lesao', 'incidente_ambiental']
          && request.resource.data.get('incidentDate', '') is string
          && request.resource.data.get('incidentDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.get('title', '') is string
          && request.resource.data.get('title', '').size() >= 3
          && request.resource.data.get('title', '').size() <= 150
          && request.resource.data.get('description', '') is string
          && request.resource.data.get('description', '').size() >= 10
          && request.resource.data.get('description', '').size() <= 2000
          && request.resource.data.get('immediateAction', '') is string
          && request.resource.data.get('immediateAction', '').size() <= 1000
          && request.resource.data.get('reportedByUid', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'aberta'
          && validSafetyOccurrencePermit(request.resource.data);
      }


      function validSafetyActivityTypes(types) {
        return types is list && types.size() >= 1 && types.size() <= 7
          && types.hasOnly(['trabalho_a_quente', 'trabalho_em_altura', 'espaco_confinado', 'eletrico', 'icamento', 'abertura_de_linha', 'geral']);
      }
      function validSafetyPpeCatalogCreate() {
        let d = request.resource.data;
        return d.get('name', '') is string && d.get('name', '').size() >= 2 && d.get('name', '').size() <= 120
          && d.get('category', '') is string && d.get('category', '').size() >= 2 && d.get('category', '').size() <= 80
          && d.get('caNumber', '') is string && d.get('caNumber', '').size() > 0 && d.get('caNumber', '').size() <= 40
          && d.get('caExpiresAt', '') is string && d.get('caExpiresAt', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validSafetyActivityTypes(d.get('requiredForPermitTypes', []))
          && d.get('active', false) == true && d.get('createdByUid', '') == request.auth.uid;
      }
      function validSafetyTrainingCatalogCreate() {
        let d = request.resource.data;
        return d.get('code', '') is string && d.get('code', '').size() >= 2 && d.get('code', '').size() <= 40
          && d.get('title', '') is string && d.get('title', '').size() >= 3 && d.get('title', '').size() <= 140
          && validSafetyActivityTypes(d.get('requiredForPermitTypes', []))
          && d.get('active', false) == true && d.get('createdByUid', '') == request.auth.uid;
      }




    match /safety_permits/{permitId} {
      allow read: if canRead(resource) && (resource == null || areaOk(orgOf(resource.data), A_OPS(), 1));
      allow create: if canCreate()
        && areaOk(orgOf(request.resource.data), A_OPS(), 2)
        && validSafetyPermitCreate(permitId);
      allow update, delete: if false;
    }

    match /safety_permit_events/{eventId} {
      allow read: if canRead(resource) && (resource == null || areaOk(orgOf(resource.data), A_OPS(), 1));
      allow create: if canCreate()
        && areaOk(orgOf(request.resource.data), A_OPS(), 2)
        && validSafetyPermitEventCreate();
      allow update, delete: if false;
    }

    match /safety_permit_states/{permitId} {
      allow read: if canRead(resource) && (resource == null || areaOk(orgOf(resource.data), A_OPS(), 1));
      allow create: if canCreate()
        && areaOk(orgOf(request.resource.data), A_OPS(), 2)
        && validSafetyPermitStateCreate(permitId);
      allow update, delete: if false;
    }

    match /safety_ppe_catalog/{catalogId} {
      allow read: if canRead(resource) && (resource == null || areaOk(orgOf(resource.data), A_OPS(), 1));
      allow create: if canCreate() && areaOk(orgOf(request.resource.data), A_OPS(), 2)
        && hasRole(orgOf(request.resource.data), ['Admin', 'Gerente', 'Supervisor'])
        && request.resource.data.get('id', '') == catalogId
        && validSafetyPpeCatalogCreate();
      allow update: if canUpdate() && areaOk(orgOf(resource.data), A_OPS(), 2)
        && hasRole(orgOf(resource.data), ['Admin', 'Gerente', 'Supervisor'])
        && request.resource.data.get('id', '') == catalogId
        && request.resource.data.get('orgId', '') == orgOf(resource.data)
        && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'caNumber', 'caExpiresAt', 'requiredForPermitTypes', 'active', 'notes', 'updatedAt']);
      allow delete: if false;
    }

    match /safety_ppe_movements/{movementId} {
      allow read: if canRead(resource) && (resource == null || areaOk(orgOf(resource.data), A_OPS(), 1));
      allow write: if false;
    }

    match /safety_training_catalog/{catalogId} {
      allow read: if canRead(resource) && (resource == null || areaOk(orgOf(resource.data), A_OPS(), 1));
      allow create: if canCreate() && areaOk(orgOf(request.resource.data), A_OPS(), 2)
        && hasRole(orgOf(request.resource.data), ['Admin', 'Gerente', 'Supervisor'])
        && request.resource.data.get('id', '') == catalogId
        && validSafetyTrainingCatalogCreate();
      allow update: if canUpdate() && areaOk(orgOf(resource.data), A_OPS(), 2)
        && hasRole(orgOf(resource.data), ['Admin', 'Gerente', 'Supervisor'])
        && request.resource.data.get('id', '') == catalogId
        && request.resource.data.get('orgId', '') == orgOf(resource.data)
        && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code', 'title', 'requiredForPermitTypes', 'active', 'updatedAt']);
      allow delete: if false;
    }

    match /safety_training_records/{recordId} {
      allow read: if canRead(resource) && (resource == null || areaOk(orgOf(resource.data), A_OPS(), 1));
      allow write: if false;
    }

    match /occurrences/{occurrenceId} {
      allow create: if request.resource.data.keys().hasAny(['safetyCategory'])
        && canCreate() && areaOk(orgOf(request.resource.data), A_OPS(), 2)
        && validSafetyOccurrenceCreate(occurrenceId);
    }

    // ---- Server-only (Admin SDK) -------------------------------------------
    match /member_credentials/{id} { allow read, write: if false; }
    match /first_access_tokens/{id} { allow read, write: if false; }
    match /system_security/{id} { allow read, write: if false; } // legacy master-password doc
    match /users/{id} { allow read, write: if false; } // unused by the client
    match /receipt_images/{id} { allow read, write: if false; } // served by GET /api/reembolsos/:id/imagem
    match /server_state/{id} { allow read, write: if false; } // server markers (e.g. weekly reimbursement summary)

    // Connectivity probe in src/firebase.ts (testConnection).
    match /test/{docId} { allow get: if signedIn() && docId == 'connection'; }

    // OS number sequence: members create it once (seq >= 1) and may only bump it by 1; never reset or delete.
    match /counters/{docId} {
      allow read: if canRead(resource);
      allow create: if (isMaster() || ownerOk(request.resource.data)) && request.resource.data.get('seq', 0) >= 1
        && (isMaster() || docId == request.resource.data.get('orgId', '') + '_work_orders'); // deterministic id: no squatting another org's counter
      allow update: if sameOwner() && (isMaster() || ownerOk(resource.data))
        && request.resource.data.seq == resource.data.seq + 1;
    }

    // ---- Organizations ------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create, delete: if isMaster();
      // Padrões de acesso por área: só pelo servidor (PUT /api/org/areas), que também renova os logins.
      allow update: if isMaster() || (hasRole(orgId, ['Admin'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['areaDefaults']));
    }

    // ---- Members --------------------------------------------------------------
    match /org_members/{memberId} {
      function isSelf() {
        return resource.data.get('userId', '') == request.auth.uid || request.auth.uid == 'member_' + memberId;
      }
      // A Gerente may not create, change or remove an Admin.
      function roleOk(org, d) { return isMaster() || orgClaims()[org] == 'Admin' || d.get('role', '') != 'Admin'; }
      function manages(org) { return isMaster() || hasRole(org, ['Admin', 'Gerente']); }

      allow read: if isMaster() || (resource == null && signedIn())
        || isMemberOf(resource.data.get('orgId', ''))
        || (signedIn() && (resource.data.get('userId', '') == request.auth.uid || request.auth.uid == 'member_' + memberId))
        || (signedIn() && request.auth.token.get('email_verified', false) == true
            && request.auth.token.get('email', null) is string
            && resource.data.get('userEmail', '') == request.auth.token.email.lower());
      // Ajuste de acesso por área: só pelo servidor (PUT /api/org/members/:id/areas).
      allow create: if !request.resource.data.keys().hasAny(['passwordHash', 'areaOverrides', 'areasUpdatedAt'])
        && request.resource.data.get('userId', '') in ['', request.auth.uid]
        && manages(request.resource.data.get('orgId', ''))
        && roleOk(request.resource.data.get('orgId', ''), request.resource.data);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordHash', 'userId', 'areaOverrides', 'areasUpdatedAt'])
        && (isMaster()
          || (manages(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId
              && roleOk(resource.data.orgId, resource.data) && roleOk(resource.data.orgId, request.resource.data))
          || (signedIn() && isSelf()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName', 'updatedAt', 'lastLoginAt'])));
      allow delete: if manages(resource.data.orgId) && roleOk(resource.data.orgId, resource.data);
    }

    // ---- Trusted devices (orgId + userId) ------------------------------------
    match /trusted_devices/{deviceId} {
      allow read: if canRead(resource);
      allow create: if canCreate() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update, delete: if (isMaster()
          || (ownerOk(resource.data)
              && (resource.data.get('userId', '') == request.auth.uid || hasRole(orgOf(resource.data), ['Admin', 'Gerente']))))
        && (request.method == 'delete' || (sameOwner() && request.resource.data.get('userId', '') == resource.data.get('userId', '')));
    }

    // ---- Operações (public/operacoes, ponte em src/modules/operations/opsBridge.ts) ----
    // Cada empresa tem a própria base em ops_orgs/{orgId}/<coleção>/<doc>.
    // Salários: área RH (ver/editar). Equipe (membros) e parâmetros (config): escrita só Admin/Gerente.
    // Demais coleções: área Operações (ver lê, editar grava).
    match /ops_orgs/{orgId}/{coll}/{docId} {
      function opsManager() { return isMaster() || hasRole(orgId, ['Admin', 'Gerente']); }
      function managerOnlyWrite() { return coll in ['membros'] || (coll == 'config' && docId == 'params'); }
      allow read: if coll == 'salarios' ? areaOk(orgId, A_RH(), 1) : areaOk(orgId, A_OPS(), 1);
      allow write: if coll == 'salarios' ? areaOk(orgId, A_RH(), 2)
        : (managerOnlyWrite() ? opsManager() && areaOk(orgId, A_OPS(), 2) : areaOk(orgId, A_OPS(), 2));
    }

    // ---- Salário da equipe de campo (fora de field_workers, que toda a Operação lê) ----
    match /field_worker_pay/{id} {
      function payOrg(d) { return d.get('orgId', ''); }
      allow read: if resource == null ? signedIn() : areaOk(payOrg(resource.data), A_RH(), 1);
      allow create: if areaOk(payOrg(request.resource.data), A_RH(), 2);
      allow update: if payOrg(request.resource.data) == payOrg(resource.data) && areaOk(payOrg(resource.data), A_RH(), 2);
      allow delete: if areaOk(payOrg(resource.data), A_RH(), 2);
    }

    // ---- Diretório de pessoas (sem salários; gravado pelo RH) -------------------
    // Operações vê quem é quem; aloca em obra mudando só obra/código.
    match /rh_directory/{id} {
      function dirOrg(d) { return d.get('orgId', ''); }
      function allocation() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unitId', 'codigoObra', 'updatedAt']);
      }
      allow read: if resource == null ? signedIn()
        : (areaOk(dirOrg(resource.data), A_RH(), 1) || areaOk(dirOrg(resource.data), A_OPS(), 1));
      allow create: if areaOk(dirOrg(request.resource.data), A_RH(), 2);
      allow update: if dirOrg(request.resource.data) == dirOrg(resource.data)
        && (areaOk(dirOrg(resource.data), A_RH(), 2) || (areaOk(dirOrg(resource.data), A_OPS(), 2) && allocation()));
      allow delete: if areaOk(dirOrg(resource.data), A_RH(), 2);
    }

    // ---- Org-scoped by orgId / organizationId field ----------------------------
    match /{coll}/{docId} {
      function orgScoped() {
        return coll in [
          // orgId
          'assets', 'checklist_runs', 'checklist_templates', 'collective_asset_categories',
          'collective_asset_movements', 'collective_asset_services', 'collective_asset_workers',
          'collective_assets', 'construction_milestones', 'construction_reports', 'constructions',
          'engineering_documents', 'engineering_document_events', 'quality_records', 'quality_record_events', 'quality_record_states',
          'contracts', 'cost_centers', 'field_workers', 'inspections', 'item_categories', 'items',
          'lpu_approvals', 'occurrences', 'order_messages', 'recurring_orders', 'rh_batches',
          'rh_calculations', 'rh_employees', 'rh_imports', 'stock_balances', 'support_tickets',
          'teams', 'units', 'work_order_statuses', 'work_orders', 'work_shifts', 'worker_time_logs',
          // organizationId
          'commercial_clients', 'commercial_cost_compositions', 'commercial_imports',
          'commercial_materials', 'commercial_proposals', 'hr_onboardings', 'purchasing_orders',
          'purchasing_quotations', 'purchasing_receipts', 'purchasing_requisitions',
          'purchasing_suppliers', 'travel_requests', 'travel_searches'
        ];
      }
      // Append-only history.
      // Field RDOs are append-only: a correction must be a new, separately identified report.
      function immutable() { return coll in ['order_events', 'stock_movements', 'audit_logs', 'construction_reports', 'engineering_documents', 'engineering_document_events', 'quality_records', 'quality_record_events']; }
      // Doc id is the orgId.
      function perOrgDoc() { return coll in ['overtime_rules', 'collective_asset_policies', 'commercial_policies']; }

      // Área da coleção: RH, Estoque/Compras, Comercial e Engenharia exigem nível de acesso.
      // As demais coleções org-scoped continuam restritas à associação com a empresa.
      function collArea() {
        return coll in ['rh_batches', 'rh_calculations', 'rh_employees', 'rh_imports', 'hr_onboardings'] ? A_RH()
          : (coll in ['construction_reports', 'engineering_documents', 'engineering_document_events', 'quality_records', 'quality_record_events', 'quality_record_states'] ? A_OPS()
            : (coll.matches('commercial_.*') ? A_COM()
              : (coll in ['purchasing_orders', 'purchasing_quotations', 'purchasing_receipts', 'purchasing_requisitions', 'purchasing_suppliers'] ? A_STOCK() : -1)));
      }
      // Financeiro may read OCs/receipts to reconcile invoices; only Estoque may create or change them.
      function areaRead(d) {
        return coll in ['purchasing_orders', 'purchasing_receipts']
          ? (areaOk(orgOf(d), A_STOCK(), 1) || areaOk(orgOf(d), A_FIN(), 1))
          : (collArea() < 0 || areaOk(orgOf(d), collArea(), 1));
      }
      function areaWrite(d) { return collArea() < 0 || areaOk(orgOf(d), collArea(), 2); }
      // Operações aloca a pessoa numa obra: no RH muda só obra/código.
      function rhAllocation() {
        return coll == 'rh_employees' && areaOk(orgOf(resource.data), A_OPS(), 2)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unitId', 'codigoObra', 'updatedAt']);
      }

      allow read: if (orgScoped() || immutable()) && canRead(resource) && (resource == null || areaRead(resource.data));
      // Deterministic ids (finance_*, NF-e items) must embed the owner org, so one tenant cannot pre-claim another's ids.
      function idHasOrg(prefix, d) { let p = prefix + orgOf(d) + '_'; return docId.size() > p.size() && docId[0:p.size()] == p; }
      function nfeItemOk() { return coll != 'items' || docId[0:9] != 'item_nfe_' || idHasOrg('item_nfe_', request.resource.data); }
      function validRdoCreate() {
        return coll != 'construction_reports' || (
          signedIn()
          && request.resource.data.get('confirmedByUid', '') == request.auth.uid
          && request.resource.data.get('confirmedByName', '') is string
          && request.resource.data.get('confirmedByName', '').size() > 0
          && request.resource.data.get('preparedBy', '') == request.resource.data.get('confirmedByName', '')
          && request.resource.data.get('confirmedAt', '') is string
          && request.resource.data.get('confirmedAt', '').size() >= 20
          && request.resource.data.get('createdAt', '') is string
          && request.resource.data.get('createdAt', '').size() >= 20
          && request.resource.data.get('reportNumber', '') is string
          && request.resource.data.get('reportNumber', '').size() >= 12
          && request.resource.data.get('date', '') is string
          && request.resource.data.get('date', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.get('unitId', '') is string
          && request.resource.data.get('unitId', '').size() > 0
          && request.resource.data.get('contractId', '') is string
          && request.resource.data.get('contractId', '').size() > 0
          && request.resource.data.get('weather', '') in ['ensolarado', 'nublado', 'chuvoso', 'chuva_paralisante']
          && request.resource.data.get('activitiesCompleted', '') is string
          && request.resource.data.get('activitiesCompleted', '').size() > 0
          && request.resource.data.get('workforce', []) is list
          && request.resource.data.get('equipment', []) is list
          && !request.resource.data.keys().hasAny(['supervisorSignature'])
          && (request.resource.data.get('progressPercentage', null) == null
            || (request.resource.data.get('progressPercentage', null) is number
              && request.resource.data.get('progressPercentage', 0) >= 0
              && request.resource.data.get('progressPercentage', 0) <= 100))
        );
      }
      function engineeringReferencesBelongToOrg(d) {
        let unitPath = /databases/$(database)/documents/units/$(d.get('unitId', ''));
        let contractPath = /databases/$(database)/documents/contracts/$(d.get('contractId', ''));
        return exists(unitPath) && exists(contractPath)
          && get(unitPath).data.get('orgId', '') == orgOf(d)
          && get(contractPath).data.get('orgId', '') == orgOf(d);
      }
      function validEngineeringDocumentCreate() {
        return coll != 'engineering_documents' || (
          signedIn()
          && request.resource.data.get('id', '') == docId
          && orgOf(request.resource.data) is string
          && orgOf(request.resource.data).matches('^[A-Za-z0-9_-]{1,80}$')
          && request.resource.data.get('documentCode', '') is string
          && request.resource.data.get('documentCode', '').matches('^[A-Z0-9][A-Z0-9_-]{0,39}$')
          && request.resource.data.get('revision', '') is string
          && request.resource.data.get('revision', '').matches('^[A-Z0-9][A-Z0-9_-]{0,11}$')
          && docId == 'eng_' + orgOf(request.resource.data) + '_' + request.resource.data.get('documentCode', '') + '_' + request.resource.data.get('revision', '')
          && request.resource.data.get('documentGroupId', '') == 'eng_' + orgOf(request.resource.data) + '_' + request.resource.data.get('documentCode', '')
          && request.resource.data.get('title', '') is string
          && request.resource.data.get('title', '').size() >= 2
          && request.resource.data.get('title', '').size() <= 180
          && request.resource.data.get('documentType', '') in ['desenho', 'isometrico', 'pid', 'especificacao', 'mapa_solda', 'wps_pqr', 'certificado_material', 'relatorio_ensaios', 'procedimento', 'as_built', 'outro']
          && request.resource.data.get('unitId', '') is string
          && request.resource.data.get('unitId', '').size() > 0
          && request.resource.data.get('contractId', '') is string
          && request.resource.data.get('contractId', '').size() > 0
          && engineeringReferencesBelongToOrg(request.resource.data)
          && request.resource.data.get('filePath', '') is string
          && request.resource.data.get('filePath', '').matches('^engineering-documents/' + orgOf(request.resource.data) + '/' + docId + '/[A-Za-z0-9_-]{8,80}$')
          && request.resource.data.get('fileName', '') is string
          && request.resource.data.get('fileName', '').size() > 0
          && request.resource.data.get('fileName', '').size() <= 180
          && request.resource.data.get('contentType', '') in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']
          && request.resource.data.get('fileSize', 0) is number
          && request.resource.data.get('fileSize', 0) > 0
          && request.resource.data.get('fileSize', 0) <= 20 * 1024 * 1024
          && request.resource.data.get('createdByUid', '') == request.auth.uid
          && request.resource.data.get('createdByName', '') is string
          && request.resource.data.get('createdByName', '').size() > 0
          && request.resource.data.get('createdAt', null) == request.time
          && (request.resource.data.get('documentDate', null) == null
            || (request.resource.data.get('documentDate', null) is string
              && request.resource.data.get('documentDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (request.resource.data.get('notes', null) == null
            || (request.resource.data.get('notes', null) is string
              && request.resource.data.get('notes', '').size() <= 1500))
        );
      }
      function validEngineeringEventCreate() {
        return coll != 'engineering_document_events' || (
          signedIn()
          && request.resource.data.get('orgId', '') is string
          && request.resource.data.get('unitId', '') is string
          && request.resource.data.get('contractId', '') is string
          && request.resource.data.get('documentId', '') is string
          && existsAfter(/databases/$(database)/documents/engineering_documents/$(request.resource.data.get('documentId', '')))
          && getAfter(/databases/$(database)/documents/engineering_documents/$(request.resource.data.get('documentId', ''))).data.get('orgId', '') == orgOf(request.resource.data)
          && getAfter(/databases/$(database)/documents/engineering_documents/$(request.resource.data.get('documentId', ''))).data.get('unitId', '') == request.resource.data.get('unitId', '')
          && getAfter(/databases/$(database)/documents/engineering_documents/$(request.resource.data.get('documentId', ''))).data.get('contractId', '') == request.resource.data.get('contractId', '')
          && request.resource.data.get('eventType', '') in ['submitted_internal', 'approved_internal', 'rejected_internal', 'submitted_client', 'approved_client', 'rejected_client', 'marked_as_built']
          && request.resource.data.get('recordedByUid', '') == request.auth.uid
          && request.resource.data.get('recordedByName', '') is string
          && request.resource.data.get('recordedByName', '').size() > 0
          && request.resource.data.get('recordedAt', null) == request.time
          && (request.resource.data.get('eventType', '') == 'submitted_internal'
            ? getAfter(/databases/$(database)/documents/engineering_documents/$(request.resource.data.get('documentId', ''))).data.get('createdAt', null) == request.time
            : hasRole(orgOf(request.resource.data), ['Admin', 'Gerente', 'Supervisor']))
          && (request.resource.data.get('eventType', '') != 'rejected_internal'
            || (request.resource.data.get('comment', '') is string && request.resource.data.get('comment', '').size() > 0))
          && (request.resource.data.get('eventType', '') in ['submitted_client', 'approved_client', 'rejected_client']
            ? (request.resource.data.get('clientName', '') is string
              && request.resource.data.get('clientName', '').size() > 0
              && request.resource.data.get('clientReference', '') is string
              && request.resource.data.get('clientReference', '').size() > 0)
            : true)
          && (request.resource.data.get('eventType', '') != 'rejected_client'
            || (request.resource.data.get('comment', '') is string && request.resource.data.get('comment', '').size() > 0))
        );
      }
      // Optional engineering/checklist links are validated server-side when supplied.
      // Unit and contract IDs are required on the record and are selected from the active organization's lists in the client.
      function qualityOptionalReferencesBelongToOrg(d) {
        let engineeringId = d.get('engineeringDocumentId', '');
        let checklistId = d.get('checklistRunId', '');
        let engineeringPath = /databases/$(database)/documents/engineering_documents/$(engineeringId);
        let checklistPath = /databases/$(database)/documents/checklist_runs/$(checklistId);
        let engineeringValid = engineeringId == '' || (
          exists(engineeringPath)
          && get(engineeringPath).data.get('orgId', '') == orgOf(d)
          && get(engineeringPath).data.get('unitId', '') == d.get('unitId', '')
          && get(engineeringPath).data.get('contractId', '') == d.get('contractId', '')
        );
        let checklistValid = checklistId == '' || (
          exists(checklistPath)
          && get(checklistPath).data.get('orgId', '') == orgOf(d)
          && (get(checklistPath).data.get('unitId', null) == null
            || get(checklistPath).data.get('unitId', '') == ''
            || get(checklistPath).data.get('unitId', '') == d.get('unitId', ''))
        );
        return !(engineeringId != '' && checklistId != '')
          && engineeringValid
          && checklistValid;
      }

      function validQualityRecordCreate() {
        let d = request.resource.data;
        let recordType = d.get('recordType', '');
        let result = d.get('result', '');
        let isTest = recordType in ['hydrostatic_test', 'leak_test', 'functional_test'];
        let isPressureTest = recordType in ['hydrostatic_test', 'leak_test'];
        let needsCorrection = recordType in ['nonconformity', 'punch_item'] || result == 'nao_conforme';
        return coll != 'quality_records' || (
          signedIn()
          && d.get('id', '') == docId
          && d.get('recordCode', '') is string
          && d.get('recordCode', '').matches('^QLD-[0-9]{4}-[A-Z0-9]{8}$')
          && d.get('recordDate', '') is string
          && d.get('recordDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && recordType in ['visual_inspection', 'weld_inspection', 'dimensional_inspection', 'material_receipt', 'hydrostatic_test', 'leak_test', 'functional_test', 'commissioning', 'nonconformity', 'punch_item']
          && d.get('title', '') is string
          && d.get('title', '').size() >= 3
          && d.get('title', '').size() <= 180
          && d.get('description', '') is string
          && d.get('description', '').size() >= 3
          && d.get('description', '').size() <= 2000
          && result in ['conforme', 'nao_conforme', 'pendente']
          && d.get('unitId', '') is string
          && d.get('unitId', '').size() > 0
          && d.get('contractId', '') is string
          && d.get('contractId', '').size() > 0
          && qualityOptionalReferencesBelongToOrg(d)
          && d.get('createdByUid', '') == request.auth.uid
          && d.get('createdByName', '') is string
          && d.get('createdByName', '').size() > 0
          && d.get('createdAt', null) == request.time
          && (!isTest || (
            d.get('measuredValue', null) is number
            && d.get('measuredValue', 0) >= 0
            && d.get('measuredUnit', '') is string
            && d.get('measuredUnit', '').size() > 0
            && d.get('acceptanceCriteria', '') is string
            && d.get('acceptanceCriteria', '').size() > 0
          ))
          && (!isPressureTest || (
            d.get('testMedium', '') is string
            && d.get('testMedium', '').size() > 0
            && d.get('holdDurationMinutes', null) is int
            && d.get('holdDurationMinutes', 0) >= 1
            && d.get('holdDurationMinutes', 0) <= 1440
          ))
          && (!needsCorrection || (
            result == 'nao_conforme'
            && d.get('severity', '') in ['baixa', 'media', 'alta', 'critica']
            && d.get('responsibleName', '') is string
            && d.get('responsibleName', '').size() > 0
            && d.get('responsibleName', '').size() <= 120
            && d.get('dueDate', '') is string
            && d.get('dueDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          ))
          && (needsCorrection || (d.get('acceptanceCriteria', '') is string && d.get('acceptanceCriteria', '').size() > 0))
        );
      }

      function qualityInitialEventType(record) {
        return (record.get('recordType', '') in ['nonconformity', 'punch_item'] || record.get('result', '') == 'nao_conforme')
          ? 'opened' : 'submitted_for_review';
      }
      function qualityInitialStatus(record) {
        return qualityInitialEventType(record) == 'opened' ? 'open' : 'review_pending';
      }
      function qualityStatusAfter(currentStatus, eventType) {
        return eventType == 'approved' && currentStatus == 'review_pending' ? 'approved'
          : eventType == 'rejected' && currentStatus == 'review_pending' ? 'rejected'
          : eventType == 'corrective_action_submitted' && currentStatus in ['open', 'rejected', 'reopened'] ? 'correction_pending_verification'
          : eventType == 'verified' && currentStatus == 'correction_pending_verification' ? 'verified'
          : eventType == 'closed' && currentStatus == 'verified' ? 'closed'
          : eventType == 'reopened' && currentStatus == 'closed' ? 'reopened'
          : eventType == 'note_added' && currentStatus != 'unknown' ? currentStatus
          : '';
      }

      function validQualityStateCreateForDoc() {
        let recordPath = /databases/$(database)/documents/quality_records/$(docId);
        let recordData = get(recordPath).data;
        let eventId = request.resource.data.get('latestEventId', '');
        let eventPath = /databases/$(database)/documents/quality_record_events/$(eventId);
        return signedIn()
          && request.resource.data.get('id', '') == docId
          && request.resource.data.get('recordId', '') == docId
          && exists(recordPath)
          && orgOf(recordData) == orgOf(request.resource.data)
          && recordData.get('unitId', '') == request.resource.data.get('unitId', '')
          && recordData.get('contractId', '') == request.resource.data.get('contractId', '')
          && eventId is string
          && eventId.size() > 0
          && exists(eventPath)
          && get(eventPath).data.get('recordId', '') == docId
          && get(eventPath).data.get('actorUid', '') == request.auth.uid
          && get(eventPath).data.get('eventType', '') == qualityInitialEventType(recordData)
          && request.resource.data.get('status', '') == qualityInitialStatus(recordData)
          && request.resource.data.get('updatedByUid', '') == request.auth.uid
          && request.resource.data.get('updatedByName', '') is string
          && request.resource.data.get('updatedByName', '').size() > 0
          && request.resource.data.get('updatedAt', null) == request.time;
      }
      function validQualityStateCreate() {
        return coll != 'quality_record_states' || validQualityStateCreateForDoc();
      }
      function validQualityStateUpdateForDoc() {
        let eventId = request.resource.data.get('latestEventId', '');
        let eventPath = /databases/$(database)/documents/quality_record_events/$(eventId);
        let recordPath = /databases/$(database)/documents/quality_records/$(resource.data.get('recordId', ''));
        let recordData = get(recordPath).data;
        let eventExists = exists(eventPath);
        let eventData = eventExists ? get(eventPath).data : {};
        let currentStatus = resource.data.get('status', '');
        let eventType = eventData.get('eventType', '');
        let finding = recordData.get('recordType', '') in ['nonconformity', 'punch_item']
          || recordData.get('result', '') == 'nao_conforme' || currentStatus == 'rejected';
        let nextStatus = qualityStatusAfter(currentStatus, eventType);
        return signedIn()
          && request.resource.data.get('id', '') == docId
          && request.resource.data.get('recordId', '') == resource.data.get('recordId', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'latestEventId', 'updatedByUid', 'updatedByName', 'updatedAt'])
          && eventId is string
          && eventId.size() > 0
          && eventId != resource.data.get('latestEventId', '')
          && request.resource.data.get('updatedByUid', '') == request.auth.uid
          && request.resource.data.get('updatedByName', '') is string
          && request.resource.data.get('updatedByName', '').size() > 0
          && request.resource.data.get('updatedAt', null) == request.time
          && eventExists
          && eventData.get('recordId', '') == resource.data.get('recordId', '')
          && eventData.get('orgId', '') == orgOf(resource.data)
          && eventData.get('unitId', '') == resource.data.get('unitId', '')
          && eventData.get('contractId', '') == resource.data.get('contractId', '')
          && eventData.get('previousEventId', '') == resource.data.get('latestEventId', '')
          && eventData.get('actorUid', '') == request.auth.uid
          && eventData.get('actorName', '') is string
          && eventData.get('actorName', '').size() > 0
          && eventData.get('recordedAt', null) is timestamp
          && request.resource.data.get('status', '') == nextStatus
          && nextStatus != ''
          && (eventType in ['approved', 'rejected']
            ? (hasRole(orgOf(resource.data), ['Admin', 'Gerente', 'Supervisor'])
              && !finding && recordData.get('result', '') != 'pendente')
            : true)
          && (eventType in ['verified', 'closed', 'reopened']
            ? (hasRole(orgOf(resource.data), ['Admin', 'Gerente', 'Supervisor']) && finding)
            : true)
          && (eventType == 'corrective_action_submitted' ? finding : true)
          && (eventType in ['rejected', 'corrective_action_submitted', 'verified', 'closed', 'reopened', 'note_added']
            ? (eventData.get('comment', '') is string
              && eventData.get('comment', '').size() > 0
              && eventData.get('comment', '').size() <= 1500)
            : true);
      }
      function validQualityStateUpdate() {
        return coll != 'quality_record_states' || validQualityStateUpdateForDoc();
      }
      function validQualityEventCreateForDoc() {
        let recordPath = /databases/$(database)/documents/quality_records/$(request.resource.data.get('recordId', ''));
        let recordData = get(recordPath).data;
        let hasPreviousEvent = request.resource.data.keys().hasAny(['previousEventId']);
        let eventType = request.resource.data.get('eventType', '');
        return signedIn()
          && exists(recordPath)
          && recordData.get('orgId', '') == orgOf(request.resource.data)
          && recordData.get('unitId', '') == request.resource.data.get('unitId', '')
          && recordData.get('contractId', '') == request.resource.data.get('contractId', '')
          && request.resource.data.get('unitId', '') is string
          && request.resource.data.get('contractId', '') is string
          && eventType in ['submitted_for_review', 'opened', 'approved', 'rejected', 'corrective_action_submitted', 'verified', 'closed', 'reopened', 'note_added']
          && request.resource.data.get('actorUid', '') == request.auth.uid
          && request.resource.data.get('actorName', '') is string
          && request.resource.data.get('actorName', '').size() > 0
          && request.resource.data.get('recordedAt', null) == request.time
          && (hasPreviousEvent
            ? (request.resource.data.get('previousEventId', '') is string
              && request.resource.data.get('previousEventId', '').size() > 0)
            : eventType == qualityInitialEventType(recordData))
          && (eventType in ['rejected', 'corrective_action_submitted', 'verified', 'closed', 'reopened', 'note_added']
            ? (request.resource.data.get('comment', '') is string
              && request.resource.data.get('comment', '').size() > 0
              && request.resource.data.get('comment', '').size() <= 1500)
            : true);
      }
      function validQualityEventCreate() {
        return coll != 'quality_record_events' || (
          request.resource.data.get('recordId', '') is string
          && request.resource.data.get('recordId', '').size() > 0
          && validQualityEventCreateForDoc()
        );
      }
      allow create: if (orgScoped() || immutable()) && canCreate() && nfeItemOk()
        && !(coll == 'occurrences' && request.resource.data.keys().hasAny(['safetyCategory']))
        && validRdoCreate() && validEngineeringDocumentCreate() && validEngineeringEventCreate()
        && validQualityRecordCreate() && validQualityEventCreate() && validQualityStateCreate()
        && areaWrite(request.resource.data);
      allow update: if orgScoped() && !immutable() && canUpdate()
        && (coll == 'occurrences' && resource.data.keys().hasAny(['safetyCategory'])
          ? (areaWrite(resource.data) && validSafetyOccurrenceUpdate())
          : (coll == 'quality_record_states'
            ? (areaWrite(resource.data) && validQualityStateUpdate())
            : (areaWrite(resource.data) || rhAllocation())));
      allow delete: if orgScoped() && coll != 'quality_record_states' && !immutable() && canDelete() && areaWrite(resource.data)
        && !(coll == 'occurrences' && resource.data.keys().hasAny(['safetyCategory']));

      // Finance data: members read; Supervisor+ create; Admin/Gerente review divergence cases; payables retain a separate settlement rule.
      function finance() { return coll in ['finance_payables', 'finance_receivables', 'finance_receivable_receipts', 'finance_categories', 'finance_rules', 'finance_reconciliation_cases', 'finance_payable_authorizations', 'finance_payable_settlements', 'finance_bank_transactions', 'finance_bank_reconciliations']; }
      function financeRole(d, roles) { return isMaster() || hasRole(orgOf(d), roles); }
      function isPayable() { return coll == 'finance_payables'; }
      function isReconciliationCase() { return coll == 'finance_reconciliation_cases'; }
      function isPayableAuthorization() { return coll == 'finance_payable_authorizations'; }
      function isPayableSettlement() { return coll == 'finance_payable_settlements'; }
      function isBankTransaction() { return coll == 'finance_bank_transactions'; }
      function isBankReconciliation() { return coll == 'finance_bank_reconciliations'; }
      function isReceivable() { return coll == 'finance_receivables'; }
      function isReceivableReceipt() { return coll == 'finance_receivable_receipts'; }
      // Paid-state changes are server-only so the immutable settlement event and payable update stay atomic.
      function payableClientUpdate() {
        return resource.data.get('status', '') == 'aberto'
          && financeRole(resource.data, ['Admin', 'Gerente']) && fin(resource.data, 2)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'pagoEm', 'pagoPor', 'settlementId', 'valorPago', 'valorAbatido', 'saldoAberto', 'settlementCount', 'lastSettlementId', 'lastSettlementAt', 'lastSettlementBy']);
      }
      function payableClientCreate() {
        return request.resource.data.get('createdBy', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'aberto'
          && !request.resource.data.keys().hasAny(['pagoEm', 'pagoPor', 'valorPago', 'valorAbatido', 'saldoAberto', 'settlementCount', 'lastSettlementId', 'lastSettlementAt', 'lastSettlementBy', 'settlementId']);
      }
      function reconciliationCaseUpdate() {
        let oldStatus = resource.data.get('status', '');
        let newStatus = request.resource.data.get('status', '');
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'resolutionNotes', 'updatedAt'])
          && request.resource.data.get('reviewedBy', '') == request.auth.uid
          && request.resource.data.get('reviewedByName', '') is string
          && request.resource.data.get('reviewedAt', null) == request.time
          && request.resource.data.get('updatedAt', null) == request.time
          && ((oldStatus == 'aberta' && newStatus == 'em_analise')
            || (oldStatus == 'em_analise' && newStatus in ['aprovada', 'rejeitada']
              && request.resource.data.get('resolutionNotes', '') is string
              && request.resource.data.get('resolutionNotes', '').size() >= 5
              && request.resource.data.get('resolutionNotes', '').size() <= 2000));
      }
      // Payables: Admin/Gerente may edit title fields, but the paid state is changed only by the backend settlement transaction.
      // Financeiro: members read; immutable settlement events are written only by the backend.
      function fin(d, lvl) { return areaOk(orgOf(d), A_FIN(), lvl); }
      allow read: if finance() && canRead(resource) && (resource == null || fin(resource.data, 1));
      allow create: if finance() && !isPayableAuthorization() && !isPayableSettlement() && !isBankTransaction() && !isBankReconciliation() && !isReceivableReceipt() && canCreate() && (isMaster() || idHasOrg({'finance_categories': 'cat_', 'finance_payables': 'pay_', 'finance_receivables': 'recv_', 'finance_rules': 'rule_', 'finance_reconciliation_cases': 'rcase_'}[coll], request.resource.data)) && financeRole(request.resource.data, ['Admin', 'Gerente', 'Supervisor'])
        && fin(request.resource.data, 2)
        && (!isPayable() || payableClientCreate())
        && (!isReceivable() || (request.resource.data.get('id', '') == docId
          && request.resource.data.get('createdBy', '') == request.auth.uid
          && request.resource.data.get('origem', '') == 'manual'
          && request.resource.data.get('status', '') == 'aberto'
          && request.resource.data.get('cliente', null) is map
          && request.resource.data.get('cliente', {}).get('nome', '') is string
          && request.resource.data.get('cliente', {}).get('nome', '').size() > 0
          && request.resource.data.get('cliente', {}).get('nome', '').size() <= 180
          && request.resource.data.get('documento', '') is string
          && request.resource.data.get('documento', '').size() > 0
          && request.resource.data.get('documento', '').size() <= 120
          && request.resource.data.get('valor', 0) is number
          && request.resource.data.get('valor', 0) > 0
          && request.resource.data.get('valor', 0) <= 1000000000
          && request.resource.data.get('vencimento', '') is string
          && request.resource.data.get('vencimento', '').size() == 10
          && !request.resource.data.keys().hasAny(['valorRecebido', 'saldoAberto', 'receiptCount', 'lastReceiptId', 'lastReceiptAt', 'lastReceiptBy', 'recebidoEm', 'recebidoPor'])))
        && (!isReconciliationCase() || (request.resource.data.get('id', '') == docId
          && request.resource.data.get('createdBy', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'aberta'
          && request.resource.data.get('purchaseOrderId', '') is string && request.resource.data.get('purchaseOrderId', '').size() > 0
          && request.resource.data.get('issueType', '') in ['divergencia_valor_produtos', 'divergencia_preco_unitario', 'quantidade_faturada_acima', 'quantidade_recebida_sem_nf', 'qualidade_pendente', 'item_sem_vinculo', 'xml_ausente', 'outra']
          && request.resource.data.get('issueTitle', '') is string && request.resource.data.get('issueTitle', '').size() >= 5 && request.resource.data.get('issueTitle', '').size() <= 140
          && request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() >= 10 && request.resource.data.get('description', '').size() <= 4000
          && request.resource.data.get('createdByName', '') is string && request.resource.data.get('createdByName', '').size() > 0 && request.resource.data.get('createdByName', '').size() <= 160
          && request.resource.data.get('snapshot', null) is map
          && request.resource.data.get('evidenceReference', '') is string && request.resource.data.get('evidenceReference', '').size() <= 1000
          && request.resource.data.get('createdAt', null) == request.time
          && request.resource.data.get('updatedAt', null) == request.time));
      allow update: if finance() && !isPayableAuthorization() && !isPayableSettlement() && !isBankTransaction() && !isBankReconciliation() && !isReceivable() && !isReceivableReceipt() && canUpdate()
        && (isReconciliationCase()
          ? (financeRole(resource.data, ['Admin', 'Gerente']) && fin(resource.data, 2) && reconciliationCaseUpdate())
          : (isPayable()
            ? payableClientUpdate()
            : (financeRole(resource.data, ['Admin', 'Gerente', 'Supervisor']) && fin(resource.data, 2))));
      allow delete: if finance() && !isReconciliationCase() && !isPayableAuthorization() && !isPayableSettlement() && !isBankTransaction() && !isBankReconciliation() && !isReceivable() && !isReceivableReceipt() && canDelete() && financeRole(resource.data, ['Admin', 'Gerente']) && fin(resource.data, 2);

      function perOrgArea(lvl) { return coll != 'commercial_policies' || areaOk(docId, A_COM(), lvl); }
      allow read: if perOrgDoc() && (isMaster() || isMemberOf(docId)) && perOrgArea(1);
      allow write: if perOrgDoc() && (isMaster() || isMemberOf(docId)) && perOrgArea(2)
        && (request.method == 'delete'
            || (request.resource.data.get('orgId', docId) == docId && request.resource.data.get('organizationId', docId) == docId));
    }

    // ---- NF-e (written by the server; the client only moves classification status) ----
    match /nfe_documents/{id} {
      function move() { return resource.data.get('status', '') + '>' + request.resource.data.get('status', ''); }
      function run() { return resource.data.get('classificacao', {}); }
      function ownRun() { return run().get('by', '') == request.auth.uid; }
      // A run left 'classificando' for 2+ minutes (server time) — or a legacy one without startedAt — may be released by Admin/Gerente.
      function stale() { return !(run().get('startedAt', null) is timestamp) || request.time > run().startedAt + duration.value(2, 'm'); }
      function newRun() {
        let r = request.resource.data.get('classificacao', {});
        return r.get('by', '') == request.auth.uid && r.get('startedAt', null) == request.time;
      }
      function manager() { return isMaster() || hasRole(orgOf(resource.data), ['Admin', 'Gerente']); }
      allow read: if canRead(resource) && (resource == null || areaOk(orgOf(resource.data), A_FIN(), 1));
      allow update: if canUpdate() && areaOk(orgOf(resource.data), A_FIN(), 2)
        && (manager() || hasRole(orgOf(resource.data), ['Supervisor']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'classificacao', 'erroClassificacao', 'updatedAt'])
        && ((move() in ['aguardando_classificacao>classificando', 'erro_classificacao>classificando']
             && newRun())
          || (move() == 'classificando>classificada' && ownRun())
          || (move() == 'classificando>erro_classificacao' && (ownRun() || (manager() && stale()))));
    }
    match /nfe_sync/{orgId} { allow read: if areaOk(orgId, A_FIN(), 1); }

    // Items carry organizationId, but the client lists them by proposalId only: fall back to the parent proposal's org.
    match /commercial_proposal_items/{itemId} {
      function parentOrg(d) {
        return get(/databases/$(database)/documents/commercial_proposals/$(d.proposalId)).data.get('organizationId', '');
      }
      // A new/updated item must belong to its parent proposal's org (no attaching items to another org's proposal).
      function matchesParent() {
        return exists(/databases/$(database)/documents/commercial_proposals/$(request.resource.data.proposalId))
          && parentOrg(request.resource.data) == request.resource.data.get('organizationId', '');
      }
      // Área conferida pela empresa da proposta-mãe: a lista filtra só por proposalId.
      allow read: if (canRead(resource) || isMemberOf(parentOrg(resource.data)))
        && (resource == null || areaOk(parentOrg(resource.data), A_COM(), 1));
      allow create: if canCreate() && matchesParent() && areaOk(request.resource.data.get('organizationId', ''), A_COM(), 2);
      allow update: if canUpdate() && matchesParent() && areaOk(parentOrg(resource.data), A_COM(), 2);
      allow delete: if (canDelete() || isMemberOf(parentOrg(resource.data))) && areaOk(parentOrg(resource.data), A_COM(), 2);
    }

    // ---- WhatsApp bridge mirror ----------------------------------------------
    // The bridge is one server-wide instance: its data has no org owner and the server API serves it to any
    // authenticated member. The mirror matches that: any member of some org (or master).
    function waMember() { return isMaster() || hasAnyOrg(); }

    match /whatsapp_contacts/{id} { allow read, write: if waMember(); }
    match /whatsapp_quick_replies/{id} { allow read, write: if waMember(); }
    match /whatsapp_ai_rules/{id} { allow read, write: if waMember(); }
    match /whatsapp_ai_settings/{id} { allow read, write: if waMember(); }

    match /whatsapp_scheduled_jobs/{jobId} {
      allow read, delete: if waMember();
      allow create, update: if waMember()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.scheduleTime is string
        && request.resource.data.scheduleTime.matches('^\\d{2}:\\d{2}$')
        && request.resource.data.promptInstruction is string
        && request.resource.data.promptInstruction.size() > 0
        && request.resource.data.promptInstruction.size() <= 2000;
    }

    match /whatsapp_ocr_receipts/{receiptId} {
      allow read: if waMember();
      allow create, update: if waMember()
        && request.resource.data.establishmentName is string
        && request.resource.data.establishmentName.size() <= 200
        && request.resource.data.totalAmount is number;
    }

    match /whatsapp_nd_rules/{ruleId} {
      allow read, delete: if waMember();
      allow create, update: if waMember()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.groupJid is string;
    }

    match /whatsapp_nd_records/{recordId} {
      allow read: if waMember();
      allow create, update: if waMember()
        && request.resource.data.receiverName is string
        && request.resource.data.receiverName.size() <= 180
        && request.resource.data.amount is number;
    }
  }
}
