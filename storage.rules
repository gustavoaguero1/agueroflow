rules_version = '2';
// Photos of work orders: org members (custom claims set by the server) or master. Everything else denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /work-orders/{orgId}/{allPaths=**} {
      function member() {
        return request.auth != null &&
          (request.auth.token.get('master', false) == true || orgId in request.auth.token.get('orgs', {}));
      }
      allow read: if member();
      allow write: if member() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    // Anexos do módulo Operações (CTPS, notas de reembolso, prints de NF).
    match /operacoes/{orgId}/{fileId} {
      function opsMember() {
        return request.auth != null &&
          (request.auth.token.get('master', false) == true || orgId in request.auth.token.get('orgs', {}));
      }
      allow read: if opsMember();
      allow create: if opsMember() && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
