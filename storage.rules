rules_version = '2';

// Private engineering files: tenant membership + Operações level (view=1, write=2).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isMaster() { return signedIn() && request.auth.token.get('master', false) == true; }
    function roleAreas(role) {
      return {
        'Admin': '22222222222',
        'Gerente': '22222122212',
        'Supervisor': '12212021112',
        'Operacional': '12100010112',
        'Visualizador': '11110011112'
      }.get(role, '10000000011');
    }
    function isMember(orgId) {
      return signedIn() && orgId in request.auth.token.get('orgs', {});
    }
    function areaCode(orgId) {
      return request.auth.token.get('areas', {}).get(
        orgId,
        roleAreas(request.auth.token.get('orgs', {}).get(orgId, ''))
      );
    }
    function engineeringCanRead(orgId) {
      return isMaster() || (isMember(orgId) && int(areaCode(orgId)[1:2]) >= 1);
    }
    function engineeringCanWrite(orgId) {
      return isMaster() || (isMember(orgId) && int(areaCode(orgId)[1:2]) >= 2);
    }
    function safetyCertificateCanWrite(orgId) {
      let role = request.auth.token.get('orgs', {}).get(orgId, '');
      return isMaster() || (isMember(orgId)
        && int(areaCode(orgId)[1:2]) >= 2
        && role in ['Admin', 'Gerente', 'Supervisor']);
    }

    // OS evidence: private, same-company and immutable.
    match /work-orders/{orgId}/{allPaths=**} {
      allow read: if engineeringCanRead(orgId);
      allow create: if engineeringCanWrite(orgId)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(image/jpeg|image/png|image/webp)$');
      allow update, delete: if false;
    }

    // Legacy Operations attachments. Only the historical JSON backup can be replaced.
    match /operacoes/{orgId}/{fileId} {
      function allowedOperationsFileType() {
        return request.resource.contentType.matches('^(image/jpeg|image/png|image/webp|application/pdf|application/json|application/octet-stream)$');
      }
      function legacyJsonBackup() {
        return fileId == 'arquivos_historico.json'
          && request.resource.contentType == 'application/json';
      }
      allow read: if engineeringCanRead(orgId);
      allow create: if engineeringCanWrite(orgId)
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && (legacyJsonBackup() || (resource == null && allowedOperationsFileType()));
      allow update: if legacyJsonBackup()
        && engineeringCanWrite(orgId)
        && resource != null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024;
      allow delete: if false;
    }

    // Engineering controlled documents.
    match /engineering-documents/{orgId}/{documentId}/{fileId} {
      allow read: if engineeringCanRead(orgId);
      allow create: if engineeringCanWrite(orgId)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png|image/webp)$');
      allow update, delete: if false;
    }

    // Safety and qualification certificates.
    match /safety-certificates/{orgId}/{employeeId}/{fileId} {
      allow read: if engineeringCanRead(orgId);
      allow create: if safetyCertificateCanWrite(orgId)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png|image/webp)$');
      allow update, delete: if false;
    }

    // HR onboarding candidate documents (uploaded exclusively by backend Admin SDK).
    match /hr-onboardings/{orgId}/{onboardingId}/{fileId} {
      allow read: if isMaster() || (isMember(orgId) && int(areaCode(orgId)[5:6]) >= 1);
      allow write: if false;
    }

    // Industrial metallurgy, NDT, and material heat certificates (private, immutable).
    match /industrial-certificates/{orgId}/{recordId}/{fileId} {
      allow read: if engineeringCanRead(orgId);
      allow create: if engineeringCanWrite(orgId)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png|image/webp)$');
      allow update, delete: if false;
    }

    // Measurement Bulletin (BM) memory of calculation and evidences (private, immutable).
    match /measurement-evidences/{orgId}/{bulletinId}/{fileId} {
      allow read: if isMaster() || (isMember(orgId) && (int(areaCode(orgId)[1:2]) >= 1 || int(areaCode(orgId)[3:4]) >= 1 || int(areaCode(orgId)[4:5]) >= 1));
      allow create: if (isMaster() || (isMember(orgId) && (int(areaCode(orgId)[1:2]) >= 2 || int(areaCode(orgId)[3:4]) >= 2)))
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png|image/webp|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)$');
      allow update, delete: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
